<%- include('../partials/header', {title: title}) %>
<div class="app-container">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <h1>Gestion des Articles</h1>
        <p>Liste, ajout, modification et gestion des produits</p>
      </div>
      <div class="topbar-right">
        <% if(user.role === 'admin' || user.role === 'manager' || user.role === 'superadmin') { %>
        <a href="/articles/ajouter" class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter un Article</a>
        <% } %>
        <div class="user-info">
          <i class="fas fa-user-circle"></i>
          <span><%= user.prenom %> <%= user.nom %> - <strong><%= user.role.toUpperCase() %></strong></span>
        </div>
        <a href="/auth/logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i> Déconnexion</a>
      </div>
    </header>

    <div class="panel">
      <div class="panel-header">
        <h3><i class="fas fa-boxes"></i> Liste des Articles</h3>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Réf</th>
              <th>Image</th>
              <th>Désignation</th>
              <th>Catégorie</th>
              <th>Stock</th>
              <th>P.Achat</th>
              <th>P.Vente</th>
              <th>Marge</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if(articles && articles.length > 0) { %>
              <% articles.forEach(a => { %>
                <tr>
                  <td><%= a.reference %></td>
                  <td>
                    <% if(a.images && a.images.length > 0) { %>
                      <img src="/uploads/articles/<%= a.images[0] %>" width="45" height="45" style="border-radius:8px;object-fit:cover">
                    <% } else { %>
                      <i class="fas fa-image" style="color:#cbd5e1;font-size:24px"></i>
                    <% } %>
                  </td>
                  <td><strong><%= a.designation %></strong><br><small style="color:#64748b"><%= a.description ? a.description.substring(0,40) : '' %></small></td>
                  <td><%= a.categorie || '-' %></td>
                  <td><strong class="<%= a.stockActuel <= a.stockMin ? 'text-danger' : 'text-success' %>"><%= a.stockActuel %></strong> <%= a.unite %></td>
                  <td><%= a.prixAchat.toLocaleString() %> UM</td>
                  <td><%= a.prixVente.toLocaleString() %> UM</td>
                  <td><%= (a.prixVente - a.prixAchat).toLocaleString() %> UM</td>
                  <td>
                    <% if(a.actif) { %>
                      <span class="badge badge-success">Actif</span>
                    <% } else { %>
                      <span class="badge badge-danger">Inactif</span>
                    <% } %>
                    <% if(a.stockActuel <= a.stockMin) { %>
                      <span class="badge badge-warning">Alerte</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="actions">
                      <% if(user.role === 'admin' || user.role === 'manager' || user.role === 'superadmin') { %>
                        <a href="/articles/modifier/<%= a._id %>" class="btn btn-warning" style="padding:6px 10px"><i class="fas fa-edit"></i></a>
                      <% } %>
                      <% if(user.role === 'admin' || user.role === 'superadmin') { %>
                        <form action="/articles/supprimer/<%= a._id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirm('Supprimer cet article?')">
                          <button class="btn btn-danger" style="padding:6px 10px"><i class="fas fa-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="10" style="text-align:center;padding:40px">Aucun article enregistré</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
