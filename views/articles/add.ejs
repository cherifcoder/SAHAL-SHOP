<%- include('../partials/header', {title: title}) %>
<div class="app-container">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <h1>Ajouter un Article</h1>
        <p>Nouvel article avec images et description</p>
      </div>
      <div class="topbar-right">
        <a href="/articles" class="btn" style="background:#64748b;color:white"><i class="fas fa-arrow-left"></i> Retour</a>
      </div>
    </header>

    <div class="panel" style="max-width:1000px">
      <div class="panel-header">
        <h3><i class="fas fa-plus-circle"></i> Informations de l'article</h3>
      </div>
      <div style="padding:30px">
        <form action="/articles/ajouter" method="POST" enctype="multipart/form-data">
          <div class="grid-2">
            <div class="form-group">
              <label>Référence (Auto-générée)</label>
              <input type="text" name="reference" id="refAuto" readonly style="background:#f1f5f9">
            </div>
            <div class="form-group">
              <label>Désignation *</label>
              <input type="text" name="designation" required>
            </div>
          </div>
          <div class="form-group">
            <label>Description</label>
            <textarea name="description" rows="3"></textarea>
          </div>
          <div class="grid-2">
            <div class="form-group">
              <label>Catégorie *</label>
              <select name="categorie" required>
                <option value="">-- Sélectionner une catégorie --</option>
                <option value="Electroménager">Électroménager</option>
                <option value="Informatique">Informatique</option>
                <option value="Electronique">Électronique</option>
                <option value="Alimentation">Alimentation</option>
                <option value="Soins et beauté">Soins et beauté</option>
                <option value="Hygiène">Hygiène</option>
                <option value="Vêtements">Vêtements</option>
                <option value="Chaussures">Chaussures</option>
                <option value="Maison et décoration">Maison et décoration</option>
                <option value="Bricolage">Bricolage</option>
                <option value="Jouets">Jouets</option>
                <option value="Sport et loisir">Sport et loisir</option>
                <option value="Automobile">Automobile</option>
                <option value="Autre">Autre</option>
              </select>
            </div>
            <div class="form-group">
              <label>Marque</label>
              <input type="text" name="marque">
            </div>
          </div>
          <div class="grid-2">
            <div class="form-group">
              <label>Prix d'Achat (UM) *</label>
              <input type="number" name="prixAchat" step="0.01" min="0" required>
            </div>
            <div class="form-group">
              <label>Prix de Vente (UM) *</label>
              <input type="number" name="prixVente" step="0.01" min="0" required>
            </div>
          </div>
          <div class="grid-2">
            <div class="form-group">
              <label>Stock Actuel *</label>
              <input type="number" name="stockActuel" min="0" value="0" required>
            </div>
            <div class="form-group">
              <label>Stock Minimum *</label>
              <input type="number" name="stockMin" min="0" value="5" required>
            </div>
          </div>
          <div class="grid-2">
            <div class="form-group">
              <label>Unité</label>
              <input type="text" name="unite" value="Unité">
            </div>
            <div class="form-group">
              <label>Emplacement</label>
              <input type="text" name="emplacement">
            </div>
          </div>
          <div class="form-group">
            <label>Fournisseur</label>
            <input type="text" name="fournisseur">
          </div>
          <div class="form-group">
            <label>Images (JPG, PNG, GIF, WEBP - Max 5)</label>
            <input type="file" name="images" multiple accept="image/*">
          </div>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
        </form>
      </div>
    </div>
  </main>
</div>
<script>
  function generateRef() {
    const date = new Date();
    const year = date.getFullYear().toString().slice(-2);
    const month = String(date.getMonth()+1).padStart(2,'0');
    const day = String(date.getDate()).padStart(2,'0');
    const rand = Math.floor(10000 + Math.random() * 90000);
    document.getElementById('refAuto').value = 'ART-' + year + month + day + '-' + rand;
  }
  generateRef();
</script>
<%- include('../partials/footer') %>
