<%- include('../partials/header', {title: title}) %>
<div class="app-container">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <h1>Remboursement de Crédit</h1>
        <p>Client: <%= credit.client.prenom %> <%= credit.client.nom %></p>
      </div>
      <div class="topbar-right">
        <a href="/credits" class="btn" style="background:#64748b;color:white"><i class="fas fa-arrow-left"></i> Retour</a>
      </div>
    </header>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:25px">
      <div class="panel">
        <div class="panel-header">
          <h3><i class="fas fa-info-circle"></i> Détails du crédit</h3>
        </div>
        <div style="padding:25px">
          <p><strong>Facture:</strong> <%= credit.vente.numeroFacture %></p>
          <p><strong>Montant Initial:</strong> <%= credit.montantInitial.toLocaleString() %> UM</p>
          <p><strong>Montant Payé:</strong> <%= credit.montantPaye.toLocaleString() %> UM</p>
          <p><strong>Reste à Payer:</strong> <span style="color:#dc2626;font-size:20px;font-weight:bold"><%= credit.montantRestant.toLocaleString() %> UM</span></p>
          <p><strong>Statut:</strong> <%= credit.statut %></p>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h3><i class="fas fa-money-bill"></i> Effectuer un remboursement</h3>
        </div>
        <div style="padding:25px">
          <form action="/credits/rembourser/<%= credit._id %>" method="POST">
            <div class="form-group">
              <label>Montant à rembourser (FCFA) *</label>
              <input type="number" name="montant" max="<%= credit.montantRestant %>" min="1" required>
            </div>
            <div class="form-group">
              <label>Mode de Paiement</label>
              <select name="modePaiement">
                <option value="ESPECES">Espèces</option>
                <option value="MOBILE_MONEY">Mobile Money</option>
                <option value="CARTE">Carte</option>
                <option value="CHEQUE">Chèque</option>
                <option value="AUTRE">Autre</option>
              </select>
            </div>
            <div class="form-group">
              <label>Observations</label>
              <textarea name="observations" rows="2"></textarea>
            </div>
            <button type="submit" class="btn btn-success" style="width:100%"><i class="fas fa-check"></i> Valider le remboursement</button>
          </form>
        </div>
      </div>
    </div>

    <% if(remboursements && remboursements.length > 0) { %>
    <div class="panel">
      <div class="panel-header">
        <h3><i class="fas fa-history"></i> Historique des remboursements</h3>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr><th>Date</th><th>Montant</th><th>Mode</th><th>Observations</th></tr>
          </thead>
          <tbody>
            <% remboursements.forEach(r => { %>
              <tr>
                <td><%= r.dateRemboursement.toLocaleString('fr-FR') %></td>
                <td><strong><%= r.montant.toLocaleString() %> FCFA</strong></td>
                <td><%= r.modePaiement %></td>
                <td><%= r.observations || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>
  </main>
</div>
<%- include('../partials/footer') %>
