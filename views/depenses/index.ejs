<%- include('../partials/header', {title: title}) %>
<div class="app-container">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <h1>Gestion des Dépenses</h1>
        <p>Total: <%= total.toLocaleString() %> UM</p>
      </div>
      <div class="topbar-right">
        <% if(user.role === 'admin' || user.role === 'manager' || user.role === 'superadmin') { %>
          <a href="/depenses/ajouter" class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter une Dépense</a>
        <% } %>
      </div>
    </header>

    <div class="panel">
      <div class="panel-header">
        <h3><i class="fas fa-money-bill-wave"></i> Liste des Dépenses</h3>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Libellé</th>
              <th>Catégorie</th>
              <th>Montant</th>
              <th>Bénéficiaire</th>
              <th>Mode Paiement</th>
              <th>Effectué par</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if(depenses && depenses.length > 0) { %>
              <% depenses.forEach(d => { %>
                <tr>
                  <td><%= d.dateDepense.toLocaleDateString('fr-FR') %></td>
                  <td><strong><%= d.libelle %></strong></td>
                  <td><span class="badge badge-info"><%= d.categorie %></span></td>
                  <td><strong><%= d.montant.toLocaleString() %> UM</strong></td>
                  <td><%= d.beneficiaire || '-' %></td>
                  <td><%= d.modePaiement %></td>
                  <td><%= d.effectuePar ? (d.effectuePar.prenom + ' ' + d.effectuePar.nom) : '-' %></td>
                  <td>
                    <% if(user.role === 'admin') { %>
                      <form action="/depenses/supprimer/<%= d._id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirm('Supprimer cette dépense?')">
                        <button class="btn btn-danger" style="padding:6px 10px"><i class="fas fa-trash"></i></button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="8" style="text-align:center;padding:40px">Aucune dépense</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
