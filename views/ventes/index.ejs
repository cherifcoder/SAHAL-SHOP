<%- include('../partials/header', {title: title}) %>
<div class="app-container">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <h1>Historique des Ventes</h1>
        <p>Liste de toutes les ventes</p>
      </div>
      <div class="topbar-right">
        <a href="/ventes/nouvelle" class="btn btn-primary"><i class="fas fa-plus"></i> Nouvelle Vente</a>
      </div>
    </header>

    <div class="panel">
      <div class="panel-header">
        <h3><i class="fas fa-file-invoice"></i> Toutes les ventes</h3>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>N° Facture</th>
              <th>Date</th>
              <th>Client</th>
              <th>Type</th>
              <th>Total</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if(ventes && ventes.length > 0) { %>
              <% ventes.forEach(v => { %>
                <tr>
                  <td><strong><%= v.numeroFacture %></strong></td>
                  <td><%= v.dateVente.toLocaleString('fr-FR') %></td>
                  <td><%= v.client ? (v.client.prenom + ' ' + v.client.nom) : 'Anonyme' %></td>
                  <td><span class="badge <%= v.typeVente === 'CREDIT' ? 'badge-warning' : 'badge-success' %>"><%= v.typeVente %></span></td>
                  <td><%= v.total.toLocaleString() %> FCFA</td>
                  <td><span class="badge badge-success"><%= v.statut %></span></td>
                  <td>
                    <a href="/ventes/facture/<%= v._id %>" class="btn btn-info" style="padding:6px 10px"><i class="fas fa-eye"></i></a>
                    <a href="/ventes/facture/pdf/<%= v._id %>" class="btn btn-danger" style="padding:6px 10px"><i class="fas fa-file-pdf"></i></a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="7" style="text-align:center;padding:40px">Aucune vente</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
